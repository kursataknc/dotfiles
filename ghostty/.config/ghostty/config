# ==============================================================================
# GHOSTTY TERMINAL CONFIGURATION
# ==============================================================================

# Shell — each window gets its OWN independent tmux session (auto-named
# 0, 1, 2…). No shared `main` session, so windows never mirror each other
# or collide on size. Closing the window ends its session.
# Ghostty runs `command` via a bare `bash --noprofile --norc`, so no rc file
# ever sets PATH -- `tmux` isn't found even though it's installed. Prepend
# the common Homebrew/Linux bin dirs explicitly instead of relying on PATH
# from a shell profile that never gets sourced here.
command = /bin/sh -c "PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:$PATH exec tmux new-session"
# command = nu --login

# Appearance
theme = catppuccin-mocha
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 12

# Window & Background
background-opacity = 0.95
background-blur = 20
window-decoration = true
window-padding-x = 5
window-padding-y = 5

# Cursor
cursor-style = block
cursor-style-blink = false

# Mouse
mouse-hide-while-typing = true
clipboard-trim-trailing-spaces = true

# Performance (macOS-only; ignored on Linux)
macos-non-native-fullscreen = true

# Keybindings — `super` is Cmd on macOS / Super (Win) on Linux. Same binding
# works for both; Ctrl-equivalent shortcuts can be added per-OS if desired.
keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard
keybind = super+n=new_window
keybind = super+t=new_tab
keybind = super+w=close_surface
keybind = super+shift+t=reload_config

# Font features (ligatures)
font-feature = -calt
font-feature = -liga